{
  "name": "@diffinery/app",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -e dev",
    "deploy": "wrangler deploy -c wrangler.deploy.jsonc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p islands",
    "test": "vitest run --passWithNoTests --exclude 'test/e2e/**'",
    "cf-typegen": "wrangler types",
    "e2e": "node --test --test-concurrency=1 --test-timeout=600000 test/e2e/e2e.test.mjs test/e2e/passkeys.test.mjs test/e2e/accounts.test.mjs test/e2e/registry.test.mjs test/e2e/email.test.mjs test/e2e/security-txt.test.mjs test/e2e/security.test.mjs test/e2e/security-limits.test.mjs test/e2e/agentic.test.mjs test/e2e/tasks.test.mjs test/e2e/terminals.test.mjs test/e2e/review.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply diffinery-dev --local -e dev",
    "build": "node islands/build.mjs && node scripts/build-docs.mjs",
    "predev": "node islands/build.mjs && node scripts/build-docs.mjs",
    "build:docs": "node scripts/build-docs.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@diffinery/git-core": "workspace:*",
    "@diffinery/shared": "workspace:*",
    "@diffinery/workflow-yaml": "workspace:*",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@simplewebauthn/server": "14.0.3",
    "graphql": "16.14.2",
    "hono": "^4.13.0",
    "shiki": "4.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/kumo": "2.14.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@octokit/rest": "22.0.1",
    "@phosphor-icons/react": "2.1.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "esbuild": "0.25.11",
    "playwright": "1.56.1",
    "postcss": "8.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.9.3",
    "undici": "6.23.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
